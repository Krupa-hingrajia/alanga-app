NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# CORS — restrict to known production origins
# Add your admin panel domain and any other trusted origins (comma-separated or specific domain)
CORS_ORIGIN=https://admin.alanga.com

# ============================================================
# DATABASE — Production Supabase PostgreSQL
# ⚠️  Replace with your PRODUCTION Supabase project credentials
#     (Get from: Supabase Dashboard → Project → Settings → Database)
# ============================================================
DATABASE_URL="postgresql://postgres.YOUR_PROD_PROJECT_REF:YOUR_PROD_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROD_PROJECT_REF:YOUR_PROD_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ============================================================
# JWT — PRODUCTION SECRETS
# ⚠️  MUST be replaced with strong random secrets before deploying.
#     Generate with: openssl rand -base64 64
# ============================================================
JWT_ACCESS_SECRET="REPLACE_WITH_STRONG_PRODUCTION_ACCESS_SECRET_MIN_64_CHARS"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="REPLACE_WITH_STRONG_PRODUCTION_REFRESH_SECRET_MIN_64_CHARS"
JWT_REFRESH_EXPIRATION="7d"
