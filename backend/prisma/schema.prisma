datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id                 String     @id @default(uuid())
  fullName           String     @map("full_name")
  email              String     @unique
  countryCode        String     @map("country_code")
  mobileNumber       String     @unique @map("mobile_number")
  password           String
  role               Role       @default(CUSTOMER)
  status             UserStatus @default(ACTIVE)
  businessName       String?    @map("business_name")
  businessType       String?    @map("business_type")
  city               String?
  state              String?
  pincode            String?
  gstNumber          String?    @map("gst_number")
  panNumber          String?    @map("pan_number")
  hashedRefreshToken String?    @map("hashed_refresh_token")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  products           Product[]
  customerOrders     Order[]    @relation("CustomerOrders")

  @@map("users")
}

model Product {
  id                String      @id @default(uuid())
  name              String
  description       String?
  shortDescription  String?     @map("short_description")
  categoryId        String      @map("category_id")
  category          Category    @relation(fields: [categoryId], references: [id])
  subCategoryId     String      @map("sub_category_id")
  subCategory       SubCategory @relation(fields: [subCategoryId], references: [id])
  brandId           String      @map("brand_id")
  brand             Brand       @relation(fields: [brandId], references: [id])
  sellingPrice      Float       @map("selling_price")
  mrp               Float
  taxPercentage     Float       @default(0) @map("tax_percentage")
  stock             Int         @default(0)
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  sku               String      @unique
  status            String      @default("DRAFT")
  vendorId          String      @map("vendor_id")
  vendor            User        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")
  createdBy         String?     @map("created_by")
  updatedBy         String?     @map("updated_by")
  createdByVendorId String?     @map("created_by_vendor_id")
  approvedByAdminId String?     @map("approved_by_admin_id")
  approvedAt        DateTime?   @map("approved_at")
  rejectedReason    String?     @map("rejected_reason")

  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  customerId  String      @map("customer_id")
  customer    User        @relation("CustomerOrders", fields: [customerId], references: [id])
  status      String      @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  totalAmount Float       @map("total_amount")
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_items")
}

model Category {
  id                String        @id @default(uuid())
  name              String        @unique
  description       String?
  image             String?
  sortOrder         Int           @default(0) @map("sort_order")
  status            String        @default("PENDING")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdBy         String?       @map("created_by")
  updatedBy         String?       @map("updated_by")
  createdByVendorId String?       @map("created_by_vendor_id")
  approvedByAdminId String?       @map("approved_by_admin_id")
  approvedAt        DateTime?     @map("approved_at")
  rejectedReason    String?       @map("rejected_reason")
  subCategories     SubCategory[]
  products          Product[]

  @@map("categories")
}

model SubCategory {
  id                String    @id @default(uuid())
  categoryId        String    @map("category_id")
  category          Category  @relation(fields: [categoryId], references: [id])
  name              String
  description       String?
  image             String?
  sortOrder         Int       @default(0) @map("sort_order")
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  createdByVendorId String?   @map("created_by_vendor_id")
  approvedByAdminId String?   @map("approved_by_admin_id")
  approvedAt        DateTime? @map("approved_at")
  rejectedReason    String?   @map("rejected_reason")
  products          Product[]

  @@map("sub_categories")
}

model Brand {
  id                String    @id @default(uuid())
  name              String    @unique
  logo              String?
  description       String?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  createdByVendorId String?   @map("created_by_vendor_id")
  approvedByAdminId String?   @map("approved_by_admin_id")
  approvedAt        DateTime? @map("approved_at")
  rejectedReason    String?   @map("rejected_reason")
  products          Product[]

  @@map("brands")
}

model Unit {
  id        String    @id @default(uuid())
  name      String    @unique
  shortName String    @map("short_name")
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  @@map("units")
}

model ProductAttribute {
  id        String           @id @default(uuid())
  name      String           @unique
  status    String           @default("ACTIVE")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  createdBy String?          @map("created_by")
  updatedBy String?          @map("updated_by")
  values    AttributeValue[]

  @@map("product_attributes")
}

model AttributeValue {
  id          String           @id @default(uuid())
  attributeId String           @map("attribute_id")
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id])
  value       String
  sortOrder   Int              @default(0) @map("sort_order")
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  createdBy   String?          @map("created_by")
  updatedBy   String?          @map("updated_by")

  @@map("attribute_values")
}
