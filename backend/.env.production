NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# Database Connections (Placeholder - setup in Vercel Dashboard)
DATABASE_URL="postgresql://username:password@host:port/database_name?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:port/database_name?schema=public"

# JWT Configurations (Placeholder - setup in Vercel Dashboard)
JWT_ACCESS_SECRET="your-production-jwt-access-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-production-jwt-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"
