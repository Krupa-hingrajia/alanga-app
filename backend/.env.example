PORT=3000

# Database Connections
DATABASE_URL="postgresql://username:password@host:port/database_name?schema=public"
DIRECT_URL="postgresql://username:password@host:port/database_name?schema=public"

# JWT Configurations
JWT_ACCESS_SECRET="your-jwt-access-secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

# Payment Gateways (Razorpay & Cashfree)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"

CASHFREE_APP_ID="cf_app_placeholder"
CASHFREE_SECRET_KEY="cf_secret_placeholder"
CASHFREE_ENV="TEST" # TEST or PROD
